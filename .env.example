# Copy to .env and load with `node --env-file=.env`. Nothing here is committed.

# ── contracts ────────────────────────────────────────────────────────────────
# Deployer key. Only needed to run the deploy script.
PRIVATE_KEY=
# Where launch fees and the protocol fee share go. Defaults to the deployer.
CLINK_TREASURY=

# ── api ──────────────────────────────────────────────────────────────────────
PORT=8787
# The deployed launchpad. Until this is set, /api/tokens returns an empty list
# and says so rather than pretending there are no coins.
CLINK_LAUNCHPAD=
# Absolute origin the API is reachable at. Baked into the image and metadata
# URLs it hands out, which are then committed on chain, so it must be the real
# public origin in production.
CLINK_PUBLIC_URL=http://localhost:8787
CLINK_DATA_DIR=./data
CLINK_RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood-rpc.publicnode.com
# Signs the origin block of coins planned over MCP, so anyone can verify a coin
# was launched from an assistant. A throwaway key that never holds funds:
#   node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
# Without it MCP launches still work and carry an unsigned origin.
CLINK_ATTESTER_KEY=

# ── web ──────────────────────────────────────────────────────────────────────
VITE_LAUNCHPAD=
